# ── Copy this file to .env and edit as needed ─────────────────────────────────
# cp .env.example .env

# LLM (when running WITHOUT Docker, point to your local Ollama)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
LLM_TIMEOUT=300

# Web server
WEB_HOST=0.0.0.0
WEB_PORT=8888
AUTO_REFRESH_INTERVAL=3

# Pipeline tuning
POLLING_INTERVAL=5
MAX_EVENTS_PER_CYCLE=5
MAX_EVENTS_STORED=500
MAX_LOG_ENTRIES=1000

# Pattern discovery
SIMILARITY_THRESHOLD=0.7
MIN_PATTERN_EVENTS=1
MAX_PATTERNS=100
MIN_SEVERITY_FOR_MITIGATION=3

# Live feed streaming (set to true to enable Mastodon / CTI feeds)
ENABLE_FEEDS=false
# EXTERNAL_FEEDS=https://urlhaus.abuse.ch/downloads/csv_recent/

# Logging
LOG_LEVEL=INFO
